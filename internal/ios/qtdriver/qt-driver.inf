; WinUSB for the iPhone's QuickTime screen-capture interface (interface 2).
; DeviceShell installs it during the automatic iPhone preparation (internal/ios/qtdriver)
; and reads the interface through winusb.dll (internal/ios/quicktime).
; Interface 2 is otherwise Apple's USB Ethernet (tethering).
[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
DriverVer   = 10/31/2026,1.0.0.0
CatalogFile = qt-driver.cat
PnpLockdown = 1

[Manufacturer]
%ProviderName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_05AC&PID_12A8&MI_02

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{4cf7e09a-414f-43a2-8c9c-b2ef39c9370a}"

[Strings]
ProviderName = "DeviceShell"
DeviceName   = "iPhone QuickTime capture (DeviceShell)"
